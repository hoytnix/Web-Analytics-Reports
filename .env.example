# Cloudflare API Configuration
CF_API_TOKEN=your_cloudflare_api_token_here
CF_ACCOUNT_ID=your_cloudflare_account_id_here

# Vercel API Configuration (Optional)
VERCEL_TOKEN=your_vercel_token_here
VERCEL_TEAM_ID=your_vercel_team_id_here

# Gemini API Configuration (Optional)
# If set, automatically generates AI-powered Executive Briefs for each report timeframe
# using cascading fallback: Gemini 3.8 Flash -> Gemini 3.5 Flash-Lite -> Gemini 3.5 Flash
GEMINI_API_KEY=your_gemini_api_key_here
