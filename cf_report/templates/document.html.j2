<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{ doc_title }} - {{ generated_at }}</title>
  <style>
    @page {
      size: letter landscape;
      margin: 0.35in 0.45in;
      @bottom-right {
        content: "Page " counter(page);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        font-size: 7.5pt;
        color: #94a3b8;
      }
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      color: #0f172a;
      margin: 0;
      line-height: 1.3;
      font-size: 8.5pt;
    }
    .report-section {
      page-break-after: always;
      break-after: page;
    }
    .report-section:last-child {
      page-break-after: auto;
      break-after: auto;
    }
    .header {
      border-bottom: 2px solid #f97316;
      padding-bottom: 5px;
      margin-bottom: 8px;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
    }
    h1 {
      font-size: 15pt;
      margin: 0 0 2px 0;
      color: #0f172a;
      font-weight: 700;
    }
    .sub-header {
      margin: 12px 0 8px 0;
      border-bottom: 1.5px solid #cbd5e1;
      padding-bottom: 4px;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
    }
    h2 {
      font-size: 11pt;
      margin: 0;
      color: #0f172a;
      font-weight: 700;
    }
    .meta {
      font-size: 7.5pt;
      color: #64748b;
    }
    .sub-meta {
      font-size: 7pt;
      color: #64748b;
    }
    .badge {
      display: inline-block;
      padding: 2px 7px;
      border-radius: 4px;
      font-weight: 600;
      font-size: 7.5pt;
      text-transform: uppercase;
      background: #fed7aa;
      color: #9a3412;
      margin-left: 8px;
    }
    .grid-10 {
      display: grid;
      grid-template-columns: repeat(10, 1fr);
      gap: 5px;
      margin-bottom: 8px;
    }
    .card {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 5px;
      padding: 5px 6px;
    }
    .card-cf-rum {
      border: 1.5px solid #fb923c;
      background: #fff7ed;
    }
    .card-cf-rum .card-title {
      color: #ea580c;
    }
    .card-cf-rum .card-value {
      color: #9a3412;
    }
    .card-vercel {
      border: 1.5px solid #38bdf8;
      background: #f0f9ff;
    }
    .card-vercel .card-title {
      color: #0284c7;
    }
    .card-vercel .card-value {
      color: #0369a1;
    }
    .card-title {
      font-size: 6.2pt;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: #64748b;
      margin-bottom: 2px;
      font-weight: 600;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .card-value {
      font-size: 11pt;
      font-weight: 700;
      color: #0f172a;
      white-space: nowrap;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 3px;
      font-size: 7.8pt;
    }
    th {
      background-color: #f1f5f9;
      color: #475569;
      text-align: left;
      padding: 3.5px 5px;
      font-size: 6.6pt;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      border-bottom: 1px solid #cbd5e1;
    }
    td {
      padding: 3px 5px;
      border-bottom: 1px solid #f1f5f9;
    }
    tr:nth-child(even) {
      background-color: #f8fafc;
    }
    .num {
      text-align: right;
      font-variant-numeric: tabular-nums;
    }
    th.num {
      text-align: right;
    }
    .domain-name {
      color: #0f172a;
    }
    .zone-tag {
      font-family: monospace;
      font-size: 5.8pt;
      color: #94a3b8;
    }
    code {
      font-family: SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 6.8pt;
      color: #0369a1;
      background: #f0f9ff;
      padding: 1px 3px;
      border-radius: 3px;
    }
    .breakdown-wrapper {
      page-break-before: always;
      break-before: page;
      margin-top: 10px;
    }
    .grid-2col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin-bottom: 8px;
    }
    .panel {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 5px;
      padding: 6px 8px;
      page-break-inside: avoid;
      break-inside: avoid;
    }
    .panel-header {
      font-size: 8pt;
      font-weight: 700;
      color: #1e293b;
      margin-bottom: 4px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid #f1f5f9;
      padding-bottom: 3px;
    }
    .tag {
      font-size: 6.2pt;
      font-weight: 600;
      padding: 1px 5px;
      border-radius: 3px;
      background: #e2e8f0;
      color: #475569;
    }
    .tag-green { background: #dcfce7; color: #166534; }
    .tag-blue { background: #e0f2fe; color: #075985; }
    .tag-orange { background: #ffedd5; color: #c2410c; }
    .tag-amber { background: #fef3c7; color: #92400e; }
    .tag-rose { background: #ffe4e6; color: #9f1239; }
    .tag-purple { background: #f3e8ff; color: #6b21a8; }
    .stat-pills-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 5px;
      margin: 4px 0;
    }
    .stat-pill {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 4px;
      padding: 3px 5px;
      text-align: center;
    }
    .pill-lbl {
      font-size: 5.8pt;
      text-transform: uppercase;
      color: #64748b;
      font-weight: 600;
    }
    .pill-val {
      font-size: 8.2pt;
      font-weight: 700;
      color: #0f172a;
    }
    .color-green { color: #16a34a !important; }
    .color-blue { color: #0284c7 !important; }
    .color-amber { color: #d97706 !important; }
    .color-rose { color: #e11d48 !important; }
    .color-orange { color: #ea580c !important; }
    .metric-note {
      font-size: 6.8pt;
      color: #64748b;
      margin: 3px 0 2px 0;
    }
    .split-tables {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6px;
      margin-top: 2px;
    }
    .mini-title {
      font-size: 6.8pt;
      font-weight: 700;
      color: #475569;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      margin-bottom: 2px;
    }
    .badge-status {
      display: inline-block;
      font-size: 6pt;
      font-weight: 700;
      padding: 0 3px;
      border-radius: 2px;
      margin-right: 2px;
    }
    .badge-4xx { background: #fef08a; color: #854d0e; }
    .badge-cache {
      display: inline-block;
      font-size: 6.2pt;
      font-weight: 600;
      padding: 1px 4px;
      border-radius: 3px;
    }
    .badge-cache-hit { background: #dcfce7; color: #166534; }
    .badge-cache-miss { background: #fee2e2; color: #991b1b; }
    .badge-cache-dynamic { background: #e0f2fe; color: #075985; }
    .badge-cache-bypass { background: #fef3c7; color: #92400e; }
    .badge-cache-expired { background: #f1f5f9; color: #475569; }
    .badge-cache-none { background: #f1f5f9; color: #64748b; }
    .notice-box {
      background: #faf5ff;
      border: 1px dashed #d8b4fe;
      border-radius: 4px;
      padding: 7px 9px;
      font-size: 7.2pt;
      color: #581c87;
      margin-top: 4px;
      line-height: 1.35;
    }
    .footer {
      margin-top: 8px;
      padding-top: 4px;
      border-top: 1px solid #e2e8f0;
      font-size: 7pt;
      color: #94a3b8;
      display: flex;
      justify-content: space-between;
    }
  </style>
</head>
<body>
  {% for section in sections %}
    {{ section }}
  {% endfor %}
</body>
</html>
